# Normalize line endings: LF in repo and working tree (avoids CRLF churn on Windows).
* text=auto eol=lf

# Windows scripts: CRLF so cmd.exe treats them correctly
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
