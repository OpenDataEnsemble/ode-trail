{
  "name": "ode-trail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ODE Trail — a Formulus custom app for Open Data Ensemble Community Day",
  "scripts": {
    "copy-forms": "node scripts/copy-forms.cjs",
    "dev": "npm run copy-forms && vite",
    "copy-build": "node scripts/copy-build.cjs",
    "build": "npm run copy-forms && vite build && npm run copy-build",
    "zip": "node scripts/build-zip.cjs",
    "validate:forms": "node scripts/validate-forms.cjs",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0 --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json}\" --config ../.prettierrc",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json}\" --config ../.prettierrc",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "adm-zip": "^0.5.9",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "prettier": "^3.2.5",
    "vite": "^6.4.3"
  }
}
